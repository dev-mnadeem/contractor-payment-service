# HTTP port the API listens on.
PORT=3001

# Path to the SQLite database file, relative to the repository root.
DB_STORAGE=./database.sqlite3

# Set to "true" to echo every SQL statement Sequelize runs.
DB_LOGGING=false

# Comma-separated profile ids allowed to call /admin/*. Empty means the
# Profile.isAdmin column is the only thing that grants admin access.
ADMIN_PROFILE_IDS=

# Maximum page size accepted by the ?limit= query parameter.
MAX_PAGE_SIZE=100
